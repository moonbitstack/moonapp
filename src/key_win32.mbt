///|
/// The key a Windows virtual-key code names.
///
/// Windows puts the sided modifiers in codes of their own and keeps the
/// unsided ones for the left key, so `VK_SHIFT` is the left shift and
/// `VK_LSHIFT` says so twice. Codes the platform reserves and never sends are
/// left out rather than guessed at.
pub fn Key::from_windows(code : Int32) -> Key {
  match code {
    0x08 => Backspace
    0x09 => Tab
    0x0D => Enter
    0x13 => Pause
    0x14 => CapsLock
    0x1B => Escape
    0x20 => Space
    0x21 => PageUp
    0x22 => PageDown
    0x23 => End
    0x24 => Home
    0x25 => Left
    0x26 => Up
    0x27 => Right
    0x28 => Down
    0x2C => PrintScreen
    0x2D => Insert
    0x2E => Delete
    0x30 => Digit0
    0x31 => Digit1
    0x32 => Digit2
    0x33 => Digit3
    0x34 => Digit4
    0x35 => Digit5
    0x36 => Digit6
    0x37 => Digit7
    0x38 => Digit8
    0x39 => Digit9
    0x41 => A
    0x42 => B
    0x43 => C
    0x44 => D
    0x45 => E
    0x46 => F
    0x47 => G
    0x48 => H
    0x49 => I
    0x4A => J
    0x4B => K
    0x4C => L
    0x4D => M
    0x4E => N
    0x4F => O
    0x50 => P
    0x51 => Q
    0x52 => R
    0x53 => S
    0x54 => T
    0x55 => U
    0x56 => V
    0x57 => W
    0x58 => X
    0x59 => Y
    0x5A => Z
    0x5B => MetaLeft
    0x5C => MetaRight
    0x5D => ContextMenu
    0x60 => Numpad0
    0x61 => Numpad1
    0x62 => Numpad2
    0x63 => Numpad3
    0x64 => Numpad4
    0x65 => Numpad5
    0x66 => Numpad6
    0x67 => Numpad7
    0x68 => Numpad8
    0x69 => Numpad9
    0x6A => NumpadMultiply
    0x6B => NumpadAdd
    0x6D => NumpadSubtract
    0x6E => NumpadDecimal
    0x6F => NumpadDivide
    0x70 => F1
    0x71 => F2
    0x72 => F3
    0x73 => F4
    0x74 => F5
    0x75 => F6
    0x76 => F7
    0x77 => F8
    0x78 => F9
    0x79 => F10
    0x7A => F11
    0x7B => F12
    0x7C => F13
    0x7D => F14
    0x7E => F15
    0x7F => F16
    0x80 => F17
    0x81 => F18
    0x82 => F19
    0x83 => F20
    0x84 => F21
    0x85 => F22
    0x86 => F23
    0x87 => F24
    0x90 => NumLock
    0x91 => ScrollLock
    0xA0 => ShiftLeft
    0xA1 => ShiftRight
    0xA2 => ControlLeft
    0xA3 => ControlRight
    0xA4 => AltLeft
    0xA5 => AltRight
    0xBA => Semicolon
    0xBB => Equal
    0xBC => Comma
    0xBD => Minus
    0xBE => Period
    0xBF => Slash
    0xC0 => Backquote
    0xDB => BracketLeft
    0xDC => Backslash
    0xDD => BracketRight
    0xDE => Quote
    // The unsided modifier codes mean the left key on every layout Windows ships.
    0x10 => ShiftLeft
    0x11 => ControlLeft
    0x12 => AltLeft
    other => Unknown(other)
  }
}
