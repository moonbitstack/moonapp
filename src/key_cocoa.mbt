///|
/// The key a macOS virtual key code names.
///
/// The codes are the ones the ANSI keyboard reports and do not follow the
/// letters, so this table is the only place the order appears: a host that
/// forwards `NSEvent.keyCode` unchanged gets a physical key out of it, and the
/// character the layout actually produced comes from the event's text.
pub fn Key::from_cocoa(code : Int32) -> Key {
  match code {
    0 => A
    1 => S
    2 => D
    3 => F
    4 => H
    5 => G
    6 => Z
    7 => X
    8 => C
    9 => V
    10 => Backquote
    11 => B
    12 => Q
    13 => W
    14 => E
    15 => R
    16 => Y
    17 => T
    18 => Digit1
    19 => Digit2
    20 => Digit3
    21 => Digit4
    22 => Digit6
    23 => Digit5
    24 => Equal
    25 => Digit9
    26 => Digit7
    27 => Minus
    28 => Digit8
    29 => Digit0
    30 => BracketRight
    31 => O
    32 => U
    33 => BracketLeft
    34 => I
    35 => P
    36 => Enter
    37 => L
    38 => J
    39 => Quote
    40 => K
    41 => Semicolon
    42 => Backslash
    43 => Comma
    44 => Slash
    45 => N
    46 => M
    47 => Period
    48 => Tab
    49 => Space
    50 => Backquote
    51 => Backspace
    52 => NumpadEnter
    53 => Escape
    54 => MetaRight
    55 => MetaLeft
    56 => ShiftLeft
    57 => CapsLock
    58 => AltLeft
    59 => ControlLeft
    60 => ShiftRight
    61 => AltRight
    62 => ControlRight
    63 => Fn
    64 => F17
    65 => NumpadDecimal
    67 => NumpadMultiply
    69 => NumpadAdd
    71 => NumLock
    75 => NumpadDivide
    76 => NumpadEnter
    78 => NumpadSubtract
    81 => Equal
    82 => Numpad0
    83 => Numpad1
    84 => Numpad2
    85 => Numpad3
    86 => Numpad4
    87 => Numpad5
    88 => Numpad6
    89 => Numpad7
    91 => Numpad8
    92 => Numpad9
    96 => F5
    97 => F6
    98 => F7
    99 => F3
    100 => F8
    101 => F9
    103 => F11
    105 => F13
    107 => F14
    109 => F10
    111 => F12
    113 => F15
    114 => Insert
    115 => Home
    116 => PageUp
    117 => Delete
    118 => F4
    119 => End
    120 => F2
    121 => PageDown
    122 => F1
    123 => Left
    124 => Right
    125 => Down
    126 => Up
    other => Unknown(other)
  }
}
